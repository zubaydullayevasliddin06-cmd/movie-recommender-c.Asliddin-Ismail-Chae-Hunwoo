# ----- CINEMATCH server settings -----
# 1. Copy this file and rename the copy to ".env"  (just ".env", no name in front)
# 2. Paste your OpenRouter key after the = sign below
# NEVER share your real .env or commit it to GitHub. (.gitignore already blocks it.)

# Your free OpenRouter API key from https://openrouter.ai  (looks like sk-or-...)
OPENROUTER_API_KEY=sk-or-your-key-here

# Which free AI model to use. Qwen3 (a Chinese model) is a great free default.
# Free models change over time. To see today's free list, run:
#   curl https://openrouter.ai/api/v1/models  (look for ids ending in ":free")
# Good free alternatives to paste here if one is busy:
#   meta-llama/llama-3.3-70b-instruct:free
#   openai/gpt-oss-120b:free
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

# The web address port. Leave as 3000 unless it's already in use.
PORT=3000
