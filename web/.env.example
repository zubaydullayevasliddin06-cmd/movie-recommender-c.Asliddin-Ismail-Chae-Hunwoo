# Copy this file to .env.local and fill in your keys.
# .env.local is git-ignored — never commit real keys.

# TMDB (The Movie Database) — free at themoviedb.org/settings/api
VITE_TMDB_KEY=your_tmdb_api_key_here

# RAWG (Games database) — free at rawg.io/apidocs
VITE_RAWG_KEY=your_rawg_api_key_here
